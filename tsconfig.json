{
  // Type-checks the pipeline scripts (the site has its own web/tsconfig.json). Run: npm run typecheck
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["pipeline/**/*.ts"]
}
