# Copy to .env.local (git-ignored). The pipeline scripts and the site both read it.

# Pipeline: direct Postgres connection for db-*.ts scripts. Bypasses RLS, so keep it local.
# Supabase dashboard → Connect → Session pooler.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Pipeline: Claude Batch API (pipeline/batch.ts). Not needed for the Claude Code subagent flow.
ANTHROPIC_API_KEY=

# Site: read-only access at build time, plus vote inserts from the browser (RLS limits both).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site: the public address. Leave unset for local and preview builds: robots.txt then
# blocks crawlers so a preview never gets indexed.
NEXT_PUBLIC_SITE_URL=
